# Copy this file to ".env" (same directory) and fill in real values.
# ".env" is gitignored -- it never gets committed. This file is just the template.
#
# On the workstation, create ".env" directly there (see WORKSTATION_SETUP.md) --
# it does not travel through GitHub.

CDSE_USERNAME=your_cdse_email@example.com
CDSE_PASSWORD=your_cdse_password

# Microsoft Planetary Computer subscription key (leave blank until you request one
# at https://planetarycomputer.microsoft.com/account/request)
PC_SDK_SUBSCRIPTION_KEY=
